# =========================
# Jockie Music Controller
# =========================

# Discord User Token (self-bot) hoặc Bot Token
# Nếu dùng User Account -> cần discord.py-self
DISCORD_TOKEN=YOUR_TOKEN_HERE

# ID Discord của bạn (bot chỉ nghe lệnh từ ngườ i này)
OWNER_ID=123456789012345678

# (Tùy chọn) Giới hạn server / channel cụ thể
# TARGET_GUILD_ID=987654321098765432
# TARGET_CHANNEL_ID=123456789012345678

# Prefix của Jockie Music (thường là m!)
JOCKIE_PREFIX=m!

# Delay giữa các lệnh (giây) để tránh rate-limit
DELAY_BETWEEN_CMDS=2.5

# Bật/tắt tính năng replay lịch sử
ENABLE_REPLAY_HISTORY=true

# File lưu lịch sử
HISTORY_FILE=history.json
MAX_HISTORY=500

# Log level: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
